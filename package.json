{
  "name": "cc-clean",
  "version": "1.0.0",
  "description": "Analyze and clean local Claude Code and Codex storage",
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "test:read-only": "node --disable-warning=ExperimentalWarning --test test/analyze.test.ts test/state.test.ts test/commands.test.ts test/ui.test.ts",
    "prepack": "npm run build"
  },
  "dependencies": { "@inquirer/core": "^12.0.6", "fast-string-truncated-width": "^3.0.3" },
  "devDependencies": { "@types/node": "^24.0.0", "typescript": "^5.9.0" }
}
