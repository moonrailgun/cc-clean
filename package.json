{
  "name": "cc-clean",
  "version": "1.0.2",
  "description": "Analyze and clean local Claude Code and Codex storage",
  "author": "moonrailgun",
  "license": "MIT",
  "homepage": "https://github.com/moonrailgun/cc-clean#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moonrailgun/cc-clean.git"
  },
  "bugs": {
    "url": "https://github.com/moonrailgun/cc-clean/issues"
  },
  "keywords": [
    "claude-code",
    "codex",
    "cli",
    "cleanup",
    "disk-space"
  ],
  "type": "module",
  "bin": {
    "cc-clean": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "AGENTS.md",
    "docs/native-compatibility.md",
    "docs/usage.md",
    "docs/publishing.md",
    "third_party/rtk"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning src/cli.ts",
    "build": "tsc && chmod +x dist/cli.js",
    "release": "release-it",
    "release:patch": "release-it patch",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "test:read-only": "node --disable-warning=ExperimentalWarning --test test/commands.test.ts test/agent.test.ts test/analyze.test.ts test/state.test.ts test/ui.test.ts test/slim.test.ts test/history-codec.test.ts test/protection.test.ts test/activity.test.ts test/codex-history.test.ts test/codex-shared.test.ts test/system-temp.test.ts test/session-temp.test.ts test/shell-command.test.ts test/exec-wrapper.test.ts test/rtk-*.test.ts",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run test:read-only"
  },
  "release-it": {
    "npm": {
      "publishArgs": [
        "--registry=https://registry.npmjs.org/"
      ]
    }
  },
  "dependencies": {
    "@inquirer/core": "^12.0.6",
    "fast-string-truncated-width": "^3.0.3",
    "smol-toml": "^1.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "release-it": "^21.1.2",
    "typescript": "^5.9.0"
  }
}
